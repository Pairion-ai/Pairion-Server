<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
    Checkstyle suppressions for Pairion Server.

    Suppresses Javadoc enforcement on:
      - Test sources (src/test/**)
      - Generated sources (target/generated-sources/**)
      - Records used as DTOs / data carriers (per CONVENTIONS.md user preference)
      - JPA entities (annotated with @Entity)
      - Spring @ConfigurationProperties classes
-->
<suppressions>
    <!-- Test sources — no Javadoc required -->
    <suppress files="[/\\]src[/\\]test[/\\]" checks="Javadoc.*|MissingJavadoc.*"/>

    <!-- Generated sources — no Javadoc required -->
    <suppress files="[/\\]target[/\\]generated-sources[/\\]" checks=".*"/>
    <suppress files="[/\\]build[/\\]generated[/\\]" checks=".*"/>

    <!-- package-info.java — not a class/interface, suppress type-level checks -->
    <suppress files="package-info\.java$" checks="MissingJavadocType|JavadocType"/>
</suppressions>
