<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Pairion Server Checkstyle configuration.

    Enforces Javadoc presence on all public types and methods, plus basic
    import ordering and naming conventions. Intentionally minimal — broader
    rules will be added in later milestones as needed.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">

        <!-- ════════════════════════════════════════════════════════════
             Javadoc — public types
             ════════════════════════════════════════════════════════════ -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
            <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF"/>
        </module>

        <module name="JavadocType">
            <property name="scope" value="public"/>
            <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF"/>
        </module>

        <!-- ════════════════════════════════════════════════════════════
             Javadoc — public methods
             ════════════════════════════════════════════════════════════ -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="allowMissingPropertyJavadoc" value="true"/>
            <property name="tokens" value="METHOD_DEF, ANNOTATION_FIELD_DEF"/>
        </module>

        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
        </module>

        <!-- ════════════════════════════════════════════════════════════
             Basic naming conventions
             ════════════════════════════════════════════════════════════ -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <module name="TypeName"/>

        <module name="ConstantName">
            <!-- Allow lowercase 'log' for SLF4J loggers (standard Java convention) -->
            <property name="format" value="^log$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <!-- ════════════════════════════════════════════════════════════
             Import hygiene
             ════════════════════════════════════════════════════════════ -->
        <module name="AvoidStarImport"/>

        <module name="UnusedImports"/>

        <module name="RedundantImport"/>

    </module>
</module>
