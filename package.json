{
  "name": "pairion-server",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "tsx packages/gateway/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --project contract",
    "test:leak": "echo 'No cross-user leak suite in M0 — no users exist yet'",
    "test:bench": "echo 'No latency benchmarks in M0 — no audio pipeline yet'",
    "lint": "eslint packages/*/src packages/*/tests",
    "lint:fix": "eslint --fix packages/*/src packages/*/tests",
    "typecheck": "tsc --build --force",
    "format": "prettier --write 'packages/*/src/**/*.ts' 'packages/*/tests/**/*.ts'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts' 'packages/*/tests/**/*.ts'",
    "coverage": "vitest run --coverage",
    "coverage:check": "vitest run --coverage",
    "schema:lint": "echo 'Schema linter stub — no user-scoped tables in M0'",
    "ci:all": "pnpm install --frozen-lockfile && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:contract && pnpm test:leak && pnpm test:bench && pnpm coverage:check && pnpm schema:lint",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "pino": "^10.3.1",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
