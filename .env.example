# Pairion Server — Environment Variables
#
# Copy this file to .env and fill in your values, or export these variables
# in your shell before starting the server.
#
# .env itself is NOT committed to the repository.

# ── Anthropic LLM Adapter ──────────────────────────────────────────────────────
# Required when pairion.adapters.llm=anthropic (the default adapter).
# If absent and the Anthropic adapter is selected, the server starts but LLM
# calls will fail with an authentication error.
ANTHROPIC_API_KEY=

# ── OpenSky Network ADS-B Credentials ─────────────────────────────────────────
# Optional. HTTP Basic Auth credentials for the OpenSky Network REST API.
# When absent, the ADS-B client operates unauthenticated (lower rate limits).
# Register at https://opensky-network.org to obtain credentials.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ── Pairion Home Directory ─────────────────────────────────────────────────────
# Optional. Base directory for native libraries and downloaded model files.
# Defaults to ~/.pairion when not set.
PAIRION_HOME=

# ── Embedding Adapter ─────────────────────────────────────────────────────────
# Optional. OpenAI-compatible embeddings endpoint (e.g., Ollama with nomic-embed-text).
# Required for semantic memory search. If absent, episodic storage still works but
# semantic recall is disabled.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
