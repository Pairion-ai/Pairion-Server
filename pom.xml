<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <groupId>com.pairion</groupId>
    <artifactId>pairion-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Pairion Server</name>
    <description>Ambient, voice-first, household-scale AI presence — server component</description>

    <modules>
        <module>pairion-native-whisper</module>
        <module>pairion-native-piper</module>
        <module>pairion-core</module>
        <module>pairion-adapters</module>
        <module>pairion-household</module>
        <module>pairion-memory</module>
        <module>pairion-skills</module>
        <module>pairion-agent</module>
        <module>pairion-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <archunit.version>1.3.0</archunit.version>
        <spotless.version>2.43.0</spotless.version>
        <jacoco.version>0.8.12</jacoco.version>
        <checkstyle.version>10.21.4</checkstyle.version>
        <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.pairion</groupId>
                <artifactId>pairion-native-whisper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pairion</groupId>
                <artifactId>pairion-native-piper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pairion</groupId>
                <artifactId>pairion-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pairion</groupId>
                <artifactId>pairion-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pairion</groupId>
                <artifactId>pairion-household</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pairion</groupId>
                <artifactId>pairion-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pairion</groupId>
                <artifactId>pairion-skills</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.pairion</groupId>
                <artifactId>pairion-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <version>1.22.0</version>
                                <style>AOSP</style>
                            </googleJavaFormat>
                            <removeUnusedImports/>
                        </java>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${checkstyle-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
                        <suppressionsLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/suppressions.xml</suppressionsLocation>
                        <sourceDirectories>
                            <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
                        </sourceDirectories>
                        <consoleOutput>true</consoleOutput>
                        <failOnViolation>true</failOnViolation>
                        <violationSeverity>error</violationSeverity>
                        <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${argLine} --enable-preview --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <!-- jextract-generated bindings: auto-generated from whisper.h,
                                     cannot be meaningfully unit-tested without native library.
                                     Coverage via PAIRION_NATIVE_TESTS=1 integration suite. -->
                                <exclude>com/pairion/nativelib/whisper/WhisperBindings.class</exclude>
                                <exclude>com/pairion/nativelib/whisper/RuntimeHelper.class</exclude>
                                <exclude>com/pairion/nativelib/whisper/constants*.class</exclude>
                                <exclude>com/pairion/nativelib/whisper/whisper_context_params.class</exclude>
                                <exclude>com/pairion/nativelib/whisper/whisper_full_params.class</exclude>
                                <!-- OpusDecoder.create(): the catch(OpusException) block wraps
                                     a checked exception that Concentus empirically never throws. -->
                                <exclude>com/pairion/adapters/audio/opus/OpusDecoder.class</exclude>
                                <!-- DefaultAnthropicClientWrapper: creates real OkHttp client
                                     requiring a valid API key. Unit-tested via mock boundary. -->
                                <exclude>com/pairion/adapters/llm/anthropic/DefaultAnthropicClientWrapper.class</exclude>
                                <exclude>com/pairion/adapters/llm/anthropic/DefaultAnthropicClientWrapper$*.class</exclude>
                                <!-- DefaultOpenAiCompatClientWrapper: makes real HTTP calls to an
                                     OpenAI-compatible endpoint. Contract-tested via in-process
                                     HttpServer; unit-tested via mock boundary. -->
                                <exclude>com/pairion/adapters/llm/openaicompat/DefaultOpenAiCompatClientWrapper.class</exclude>
                                <exclude>com/pairion/adapters/llm/openaicompat/DefaultOpenAiCompatClientWrapper$*.class</exclude>
                                <!-- DefaultPiperTtsNative: loads real native library from classpath.
                                     Unit-tested via LibraryLoader injection; PAIRION_NATIVE_TESTS
                                     covers the production path. -->
                                <exclude>com/pairion/adapters/tts/piper/DefaultPiperTtsNative.class</exclude>
                                <exclude>com/pairion/adapters/tts/piper/DefaultPiperTtsNative$*.class</exclude>
                                <!-- jextract-generated Piper bindings: auto-generated, not testable
                                     without native library. -->
                                <exclude>com/pairion/nativelib/piper/*.class</exclude>
                                <!-- OpusEncoder.create(): catch(OpusException) wraps a checked
                                     exception that Concentus empirically never throws. -->
                                <exclude>com/pairion/adapters/audio/opus/OpusEncoder.class</exclude>
                                <!-- ConcentusOpusEncoder.encodeFrame(): catch(OpusException) wraps
                                     a checked exception that Concentus never throws for valid PCM.
                                     Happy path, getSampleRate, and reset are tested directly. -->
                                <exclude>com/pairion/adapters/audio/opus/ConcentusOpusEncoder.class</exclude>
                                <!-- HttpAdsbDataClient: makes real HTTP calls to opensky-network.org.
                                     Unit-tested via AdsbDataClient mock boundary. -->
                                <exclude>com/pairion/adapters/data/adsb/HttpAdsbDataClient.class</exclude>
                                <exclude>com/pairion/adapters/data/adsb/HttpAdsbDataClient$*.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <executions>
                    <execution>
                        <id>checkstyle-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
