<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pairion</groupId>
        <artifactId>pairion-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pairion-native-whisper</artifactId>
    <name>Pairion Native Whisper</name>
    <description>Builds whisper.cpp from source, generates FFM bindings via jextract, packages native library as classpath resource</description>

    <properties>
        <whisper.cpp.tag>v1.8.4</whisper.cpp.tag>
        <whisper.cpp.sha>9386f239401074690479731c1e41683fbbeac557</whisper.cpp.sha>
        <whisper.cpp.src>${project.build.directory}/whisper.cpp-src</whisper.cpp.src>
        <whisper.cpp.build>${project.build.directory}/whisper.cpp-build</whisper.cpp.build>
        <jextract.version>21-jextract+1-2</jextract.version>
        <jextract.sha256>6183f3d079ed531cc5a332e6d86c0abfbc5d001f1e85f721ebc5232204c987a2</jextract.sha256>
        <jextract.home>${user.home}/.pairion/tools/jextract-21</jextract.home>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!-- Phase: initialize — clone and build whisper.cpp before generate-sources -->
                    <execution>
                        <id>clone-and-build-whisper</id>
                        <phase>initialize</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>
                                    set -e
                                    # Clone
                                    if [ ! -d "${whisper.cpp.src}/.git" ]; then
                                        git clone --depth 1 --branch ${whisper.cpp.tag} https://github.com/ggerganov/whisper.cpp.git "${whisper.cpp.src}"
                                    fi
                                    # Build
                                    cd "${whisper.cpp.src}"
                                    cmake -B "${whisper.cpp.build}" \
                                        -DGGML_METAL=ON \
                                        -DBUILD_SHARED_LIBS=ON \
                                        -DWHISPER_BUILD_EXAMPLES=OFF \
                                        -DWHISPER_BUILD_TESTS=OFF \
                                        -DCMAKE_BUILD_TYPE=Release
                                    cmake --build "${whisper.cpp.build}" --config Release -j$(sysctl -n hw.ncpu)
                                    # Copy library
                                    PLATFORM="darwin-aarch64"
                                    DEST="${project.build.outputDirectory}/native/${PLATFORM}"
                                    mkdir -p "${DEST}"
                                    LIB=$(find "${whisper.cpp.build}" -name 'libwhisper.dylib' -not -type l | head -1)
                                    if [ -z "$LIB" ]; then
                                        LIB=$(find "${whisper.cpp.build}" -name 'libwhisper*.dylib' | head -1)
                                    fi
                                    cp "$LIB" "${DEST}/libwhisper.dylib"
                                    echo "Native library copied to ${DEST}/libwhisper.dylib"
                                </argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Phase: generate-sources — jextract bindings from the built whisper.h -->
                    <execution>
                        <id>jextract-bindings</id>
                        <phase>generate-sources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>
                                    JEXTRACT="${jextract.home}/bin/jextract"
                                    if [ ! -x "$JEXTRACT" ]; then
                                        echo "WARN: jextract not installed at ${jextract.home} — skipping binding generation"
                                        exit 0
                                    fi
                                    WHISPER_H="${whisper.cpp.src}/include/whisper.h"
                                    if [ ! -f "$WHISPER_H" ]; then
                                        echo "WARN: whisper.h not found — skipping jextract"
                                        exit 0
                                    fi
                                    OUT="${project.build.directory}/generated-sources/jextract"
                                    rm -rf "$OUT"
                                    arch -x86_64 "$JEXTRACT" \
                                        --source \
                                        --output "$OUT" \
                                        --target-package com.pairion.nativelib.whisper \
                                        --header-class-name WhisperBindings \
                                        -I "${whisper.cpp.src}/ggml/include" \
                                        -I "${whisper.cpp.src}/include" \
                                        --include-function whisper_init_from_file_with_params \
                                        --include-function whisper_context_default_params_by_ref \
                                        --include-function whisper_full_default_params_by_ref \
                                        --include-function whisper_full \
                                        --include-function whisper_full_n_segments \
                                        --include-function whisper_full_get_segment_text \
                                        --include-function whisper_free \
                                        --include-struct whisper_context_params \
                                        --include-struct whisper_full_params \
                                        "$WHISPER_H"
                                    echo "jextract bindings generated to $OUT"
                                </argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-jextract-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/jextract</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
