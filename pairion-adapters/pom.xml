<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pairion</groupId>
        <artifactId>pairion-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pairion-adapters</artifactId>
    <name>Pairion Adapters</name>
    <description>Adapter SPI interfaces for external capabilities — vendor SDK imports live here and nowhere else</description>

    <dependencies>
        <dependency>
            <groupId>com.pairion</groupId>
            <artifactId>pairion-core</artifactId>
        </dependency>
        <!-- Anthropic Java SDK — vendor SDK; imports restricted to llm.anthropic package -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.25.0</version>
        </dependency>
        <!-- Concentus — pure-Java Opus encoder/decoder (MIT-style license) -->
        <dependency>
            <groupId>io.github.jaredmdobson</groupId>
            <artifactId>concentus</artifactId>
            <version>1.0.2</version>
        </dependency>
        <!-- Spring context for @Component, @ConditionalOnProperty -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
    </dependencies>
</project>
